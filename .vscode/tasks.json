{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MegaLinter (with fixes)",
      "type": "shell",
      "command": "docker run --rm -v \"${workspaceFolder}:/tmp/lint\" -e APPLY_FIXES=all oxsecurity/megalinter:v8",
